# Copia este archivo a .env y completa los valores.

# Telegram del bot que va a avisar cuando un cliente marque "ya pague"
# (crealo hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=
# Tu chat id (o el del grupo donde queres recibir los avisos)
TELEGRAM_CHAT_ID=

# Cada cuanto revisa el bot las ordenes abiertas (en milisegundos)
POLL_INTERVAL_MS=15000

# URL de la lista de ordenes P2P abiertas de Binance
BINANCE_P2P_ORDERS_URL=https://p2p.binance.com/en/orderList

# Donde se guarda la sesion logueada (cookies) despues de correr "npm run login"
AUTH_STATE_PATH=auth/state.json

# --- Scanner de arbitraje P2P (npm run scan / npm run scan:watch) ---
# Activos a escanear, separados por coma (USDT/USDC se comparan contra $1, BTC/ETH contra su spot real)
SCAN_ASSETS=USDT,USDC,BTC,ETH
# Cada cuanto repite el escaneo en modo --watch (en milisegundos). 1 hora = 3600000
SCAN_INTERVAL_MS=3600000
# Cuantas monedas mostrar arriba y abajo (mejores para vender / para comprar) en el aviso de Telegram
SCAN_TOP_N=8
# Monto de referencia (en USD) para descartar anuncios que no puedan cubrir tu operacion tipica
SCAN_TRADE_AMOUNT_USD=100
# Tasa minima de finalizacion mensual del comerciante (0 a 1) para confiar en su precio
SCAN_MIN_COMPLETION_RATE=0.85
# A partir de que porcentaje de premium/spread se marca una fila con la alerta (🔔)
SCAN_ALERT_THRESHOLD_PCT=5
# Dias de historial a conservar para poder mostrar tendencia (+/- % en 24hs)
SCAN_HISTORY_RETENTION_DAYS=14
# Pausa entre pedidos HTTP sucesivos (ms), para no golpear los endpoints publicos de una
SCAN_REQUEST_DELAY_MS=250
