# Copia este archivo a .env y completa los valores.

# Telegram del bot que va a avisar cuando un cliente marque "ya pague"
# (crealo hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=
# Tu chat id (o el del grupo donde queres recibir los avisos)
TELEGRAM_CHAT_ID=

# Cada cuanto revisa el bot las ordenes abiertas (en milisegundos)
POLL_INTERVAL_MS=15000

# URL de la lista de ordenes P2P abiertas de Binance
BINANCE_P2P_ORDERS_URL=https://p2p.binance.com/en/orderList

# Donde se guarda la sesion logueada (cookies) despues de correr "npm run login"
AUTH_STATE_PATH=auth/state.json

# --- Scanner de arbitraje P2P (npm run scan / npm run scan:watch) ---
# Activo a escanear (el mas liquido en P2P es USDT)
SCAN_ASSET=USDT
# Cada cuanto repite el escaneo en modo --watch (en milisegundos). 1 hora = 3600000
SCAN_INTERVAL_MS=3600000
# Cuantas monedas mostrar en el aviso de Telegram (el reporte completo se guarda igual)
SCAN_TOP_N=8
